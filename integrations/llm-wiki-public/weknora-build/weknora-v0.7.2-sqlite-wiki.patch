+func TestListSQLiteEscapesLikeMetacharacters(t *testing.T) {
+	db := setupWikiPagesTestDB(t)
+	repo := NewWikiPageRepository(db)
+	ctx := context.Background()
+	literal := makeWikiPage("kb-list", "concept/literal", types.WikiPageTypeConcept, types.WikiPageStatusPublished)
+	literal.Title = "100% calibration"
+	wildcardOnly := makeWikiPage("kb-list", "concept/other", types.WikiPageTypeConcept, types.WikiPageStatusPublished)
+	wildcardOnly.Title = "100X calibration"
+	require.NoError(t, repo.Create(ctx, literal))
+	require.NoError(t, repo.Create(ctx, wildcardOnly))
+
+	got, total, err := repo.List(ctx, &types.WikiPageListRequest{
+		KnowledgeBaseID: "kb-list",
+		Query:           "%",
+		Page:            1,
+		PageSize:        10,
+	})
+	require.NoError(t, err)
+	assert.Equal(t, int64(1), total)
+	require.Len(t, got, 1)
+	assert.Equal(t, literal.Slug, got[0].Slug)
+}
