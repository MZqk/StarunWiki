+func TestSearchSQLiteRegexRankingIsolationAndLimit(t *testing.T) {
+	db := setupWikiPagesTestDB(t)
+	repo := NewWikiPageRepository(db)
+	ctx := context.Background()
+
+	titleHit := makeWikiPage("kb-search", "concept/title", types.WikiPageTypeConcept, types.WikiPageStatusPublished)
+	titleHit.Title = "AI Agent 深空指南"
+	slugHit := makeWikiPage("kb-search", "concept/ai-agent-slug", types.WikiPageTypeConcept, types.WikiPageStatusPublished)
+	slugHit.Title = "Slug"
+	summaryHit := makeWikiPage("kb-search", "concept/summary", types.WikiPageTypeConcept, types.WikiPageStatusPublished)
+	summaryHit.Title = "Summary"
+	summaryHit.Summary = "AI Agent summary"
+	contentHit := makeWikiPage("kb-search", "concept/content", types.WikiPageTypeConcept, types.WikiPageStatusPublished)
+	contentHit.Title = "Content"
+	contentHit.Summary = "none"
+	contentHit.Content = "AI Agent body"
+	archived := makeWikiPage("kb-search", "concept/archived", types.WikiPageTypeConcept, types.WikiPageStatusArchived)
+	archived.Title = "AI Agent archived"
+	otherKB := makeWikiPage("kb-other", "concept/other", types.WikiPageTypeConcept, types.WikiPageStatusPublished)
+	otherKB.Title = "AI Agent other"
+	for _, page := range []*types.WikiPage{titleHit, slugHit, summaryHit, contentHit, archived, otherKB} {
+		require.NoError(t, repo.Create(ctx, page))
+	}
+
+	got, err := repo.Search(ctx, "kb-search", "ai[ -]agent|深空", 10)
+	require.NoError(t, err)
+	require.Len(t, got, 4)
+	assert.Equal(t, titleHit.Slug, got[0].Slug)
+	assert.Equal(t, slugHit.Slug, got[1].Slug)
+	assert.Equal(t, summaryHit.Slug, got[2].Slug)
+	assert.Equal(t, contentHit.Slug, got[3].Slug)
+
+	limited, err := repo.Search(ctx, "kb-search", "ai[ -]agent", 2)
+	require.NoError(t, err)
+	require.Len(t, limited, 2)
+	assert.Equal(t, titleHit.Slug, limited[0].Slug)
+	assert.Equal(t, slugHit.Slug, limited[1].Slug)
+}
