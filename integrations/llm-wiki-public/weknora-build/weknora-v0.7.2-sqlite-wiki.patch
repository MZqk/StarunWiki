+// searchSQLite preserves wiki_search's case-insensitive regex contract without
+// relying on PostgreSQL's ~* operator. The public Wiki deployment is bounded to
+// a fixed 139-page corpus, so a RE2-backed in-process scan is deterministic and
+// avoids exposing SQLite to a custom regexp extension.
+func (r *wikiPageRepository) searchSQLite(ctx context.Context, kbID string, query string, limit int) ([]*types.WikiPage, error) {
+	pattern, err := regexp.Compile("(?i:" + query + ")")
+	if err != nil {
+		return nil, fmt.Errorf("invalid wiki search regular expression: %w", err)
+	}
+	var candidates []*types.WikiPage
+	if err := r.db.WithContext(ctx).
+		Where("knowledge_base_id = ? AND status != ?", kbID, types.WikiPageStatusArchived).
+		Find(&candidates).Error; err != nil {
+		return nil, err
+	}
+	type rankedPage struct {
+		page *types.WikiPage
+		rank int
+	}
+	ranked := make([]rankedPage, 0, len(candidates))
+	for _, page := range candidates {
+		rank := 0
+		switch {
+		case pattern.MatchString(page.Title):
+			rank = 4
+		case pattern.MatchString(page.Slug):
+			rank = 3
+		case pattern.MatchString(page.Summary):
+			rank = 2
+		case pattern.MatchString(page.Content):
+			rank = 1
+		}
+		if rank > 0 {
+			ranked = append(ranked, rankedPage{page: page, rank: rank})
+		}
+	}
+	sort.SliceStable(ranked, func(i, j int) bool {
+		if ranked[i].rank != ranked[j].rank {
+			return ranked[i].rank > ranked[j].rank
+		}
+		if !ranked[i].page.UpdatedAt.Equal(ranked[j].page.UpdatedAt) {
+			return ranked[i].page.UpdatedAt.After(ranked[j].page.UpdatedAt)
+		}
+		return ranked[i].page.Slug < ranked[j].page.Slug
+	})
+	if len(ranked) > limit {
+		ranked = ranked[:limit]
+	}
+	pages := make([]*types.WikiPage, len(ranked))
+	for index := range ranked {
+		pages[index] = ranked[index].page
+	}
+	return pages, nil
+}
