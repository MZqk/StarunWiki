# The public Wiki Q&A implementation is source-controlled. Other integrations
# remain local unless they are explicitly made part of this repository.
/integrations/*
!/integrations/llm-wiki-public/

# Third-party WeKnora checkout and its local SQLite worktree. Application code
# under apps/ and deploy/ is source-controlled.
/services/WeKnora/
/services/WeKnora-sqlite-dev/

# Canonical StarunWiki runtime state. Legacy v0.1 state remains ignored in its
# original integration directory until an explicit, verified state migration.
/.runtime/
/.runtime.migrate-*/
/integrations/llm-wiki-public/.env
/integrations/llm-wiki-public/.secrets/
/integrations/llm-wiki-public/.runtime/
/integrations/llm-wiki-public/backups/
/integrations/llm-wiki-public/output/
/integrations/llm-wiki-public/release-state.json
/integrations/llm-wiki-public/authorization/public-manifest.json
/integrations/llm-wiki-public/.venv/

